# Distinct model IDs for the two calls. Leave both empty until the 4Geeks
# student models are available. Do not reuse one ID for embeddings and generation.
EMBEDDING_MODEL_ID=
GENERATION_MODEL_ID=

# OpenAI-compatible base URLs, including the /v1 prefix and no extra path.
# Example shape only: https://example.invalid/v1
EMBEDDING_BASE_URL=
GENERATION_BASE_URL=

# Keys for those two calls. Empty means the live call is not configured.
EMBEDDING_API_KEY=
GENERATION_API_KEY=

# Qdrant HTTP endpoint. Compose calls the service by name.
# On the host, without Docker, clear this line to use the embedded engine
# at data/qdrant, which is generated and not committed.
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
# QDRANT_PATH=:memory:

# Optional local open-source embedder for development. It is not a 4Geeks model
# and does not satisfy the live embeddings criterion.
# RAG_EMBED_BACKEND=fastembed
# RAG_MIN_SCORE=0.40

# Directory for agent traces. Empty uses data/agent_traces, which is generated
# and not committed.
AGENT_TRACE_DIR=

# Ticket tool. Empty base URL reads the incident manager in-process
# (the same store behind GET /api/incidents). Set a base URL to use HTTP.
INCIDENT_API_BASE_URL=
# Bearer token for that HTTP call. Empty in the example. Never commit a real token.
INCIDENT_API_TOKEN=

# Compose. Containers call each other by service name. The browser on the
# host uses the published ports below. Secrets stay empty in this example.
API_INTERNAL_URL=http://services:8000
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=30
PUBLIC_APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_PORTAL_URL=http://127.0.0.1:3000
NEXT_PUBLIC_API_ORIGIN=http://127.0.0.1:8000
EMAIL_TRANSPORT=
RESEND_API_KEY=
SENDGRID_API_KEY=
EMAIL_FROM=
PASSWORD_RESET_EXPIRE_MINUTES=30
PASSWORD_RESET_MAX_PER_HOUR=5
WATCHPACK_POLLING=true
WATCHFILES_FORCE_POLLING=true
