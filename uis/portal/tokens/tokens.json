{
  "meta": {
    "system": "signal",
    "version": "1.1.0",
    "mode": "light",
    "units": "CSS px unless stated"
  },
  "color": {
    "canvas": "#F7F8FA",
    "surface": "#FFFFFF",
    "ink": "#18202B",
    "muted": "#505E70",
    "border": "#788598",
    "subtle": "#E7ECF2",
    "action": "#B53A17",
    "on-action": "#FFFFFF",
    "action-hover": "#8F2D12",
    "action-pressed": "#73230E",
    "selected": "#FCEDE6",
    "focus": "#164DCC",
    "danger": "#A32A26",
    "success": "#236344",
    "warning": "#765000",
    "info": "#204EA0",
    "on-status": "#FFFFFF",
    "overlay": "rgba(0,0,0,.56)",
    "link": "#B53A17"
  },
  "space": {
    "0": 0,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48,
    "16": 64,
    "20": 80,
    "24": 96,
    "28": 112,
    "32": 128
  },
  "radius": {
    "control": 8,
    "card": 8,
    "pill": 999
  },
  "layout": {
    "container": 1280,
    "reading-ch": 68,
    "section-desktop": 80,
    "section-mobile": 48,
    "header-desktop": 72,
    "header-mobile": 64
  },
  "type": {
    "body": "Arial, Helvetica, sans-serif",
    "display": "Arial, Helvetica, sans-serif",
    "mono": "Consolas, Courier New, monospace",
    "display-weight": 700,
    "body-size": 16,
    "body-line-height": 1.5
  },
  "motion": {
    "fast": 120,
    "base": 180,
    "reveal": 280,
    "ease": "cubic-bezier(.2,.8,.2,1)"
  },
  "z": {
    "base": 0,
    "sticky": 10,
    "dropdown": 20,
    "overlay": 40,
    "modal": 50,
    "toast": 60,
    "tooltip": 70
  },
  "shadow": {
    "none": "none",
    "overlay": "0 16px 48px rgba(0,0,0,.16)"
  }
}