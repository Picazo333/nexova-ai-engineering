# Copia este fichero a services/api/.env y sustituye el secreto.
# El proceso lee estas variables al arrancar. No las pongas en el código.
# Genera un secreto local con: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Ticket tool. Empty base URL uses the in-process incident manager.
# A base URL switches the tool to GET /api/incidents over HTTP.
INCIDENT_API_BASE_URL=
INCIDENT_API_TOKEN=

# Correo del enlace de restablecimiento. La clave se lee solo en el servidor.
# EMAIL_TRANSPORT vacío o resend usa RESEND_API_KEY.
# EMAIL_TRANSPORT=sendgrid usa SENDGRID_API_KEY.
# EMAIL_TRANSPORT=mock guarda el mensaje en memoria y no abre conexión (pruebas).
# Sin clave no se llama al proveedor. Un mock no sustituye un envío real.
EMAIL_TRANSPORT=
RESEND_API_KEY=
SENDGRID_API_KEY=
EMAIL_FROM=
PASSWORD_RESET_EXPIRE_MINUTES=30
PASSWORD_RESET_MAX_PER_HOUR=5
PUBLIC_APP_URL=http://127.0.0.1:3000
