# Copia este fichero a services/api/.env y sustituye el secreto.
# El proceso lee estas variables al arrancar. No las pongas en el código.
# Genera un secreto local con: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Ticket tool. Empty base URL uses the in-process incident manager.
# A base URL switches the tool to GET /api/incidents over HTTP.
INCIDENT_API_BASE_URL=
INCIDENT_API_TOKEN=
